{
  "name": "gitloupe-vscode",
  "displayName": "GitLoupe — Local Git Explorer",
  "description": "Explore Git history, review changes, and rewrite safely—locally in VS Code",
  "version": "0.4.0",
  "icon": "resources/gitloupe.png",
  "publisher": "tetsuji16",
  "license": "MIT",
  "sponsor": {
    "url": "https://github.com/sponsors/tetsuji16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tetsuji16/GitLoupe.git"
  },
  "homepage": "https://github.com/tetsuji16/GitLoupe#readme",
  "bugs": {
    "url": "https://github.com/tetsuji16/GitLoupe/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "commit graph",
    "file history",
    "worktree",
    "blame",
    "local-first"
  ],
  "galleryBanner": {
    "color": "#071839",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitloupe.openGraph",
    "onCommand:gitloupe.openFileHistory",
    "onCommand:gitloupe.openRepositoryHistory",
    "onCommand:gitloupe.openLaunchpad",
    "onView:gitloupe.homeView",
    "onView:gitloupe.welcomeView",
    "onView:gitloupe.inspectView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitloupe.openGraph",
        "title": "GitLoupe: Open Commit Graph",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitloupe.openFileHistory",
        "title": "GitLoupe: Open Visual History for File or Folder",
        "icon": "$(history)"
      },
      {
        "command": "gitloupe.openRepositoryHistory",
        "title": "GitLoupe: Open Repository Visual History",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "gitloupe.openLaunchpad",
        "title": "GitLoupe: Open Pull Request Launchpad",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gitloupe.refresh",
        "title": "GitLoupe: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitloupe.openCommit",
        "title": "GitLoupe: Open Commit at Cursor"
      },
      {
        "command": "gitloupe.copyHash",
        "title": "GitLoupe: Copy Commit Hash"
      },
      {
        "command": "gitloupe.toggleBlame",
        "title": "GitLoupe: Toggle Line Blame"
      },
      {
        "command": "gitloupe.toggleHeatmap",
        "title": "GitLoupe: Toggle Heatmap"
      },
      {
        "command": "gitloupe.openStash",
        "title": "GitLoupe: View Stash"
      },
      {
        "command": "gitloupe.popStash",
        "title": "GitLoupe: Pop Stash"
      },
      {
        "command": "gitloupe.applyStash",
        "title": "GitLoupe: Apply Stash"
      },
      {
        "command": "gitloupe.dropStash",
        "title": "GitLoupe: Drop Stash"
      },
      {
        "command": "gitloupe.createStash",
        "title": "GitLoupe: Stash Changes"
      },
      {
        "command": "gitloupe.ollama.selectModel",
        "title": "GitLoupe: Select Local Ollama Model"
      },
      {
        "command": "gitloupe.ollama.setApiKey",
        "title": "GitLoupe: Set Ollama Gateway API Key"
      },
      {
        "command": "gitloupe.manageSelectedFiles",
        "title": "GitLoupe: Manage Multiple Working Files"
      },
      {
        "command": "gitloupe.toggleFileBlame",
        "title": "GitLoupe: Toggle File Blame Annotations"
      },
      {
        "command": "gitloupe.diffWithPrevious",
        "title": "GitLoupe: Open Changes with Previous File Revision"
      },
      {
        "command": "gitloupe.manageWorktree",
        "title": "GitLoupe: Manage Worktree"
      },
      {
        "command": "gitloupe.fileRevisionPrevious",
        "title": "GitLoupe: Open Previous File Revision"
      },
      {
        "command": "gitloupe.fileRevisionNext",
        "title": "GitLoupe: Open Next File Revision"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "gitloupe.openFileHistory",
          "when": "resourceScheme == file",
          "group": "gitloupe@10"
        }
      ],
      "editor/context": [
        {
          "command": "gitloupe.diffWithPrevious",
          "when": "resourceScheme == file",
          "group": "gitloupe@10"
        },
        {
          "command": "gitloupe.openFileHistory",
          "when": "resourceScheme == file",
          "group": "gitloupe@11"
        }
      ],
      "view/title": [
        {
          "command": "gitloupe.openGraph",
          "when": "view == gitloupe.homeView",
          "group": "navigation@1"
        },
        {
          "command": "gitloupe.refresh",
          "when": "view == gitloupe.homeView",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitloupe",
          "title": "GitLoupe",
          "icon": "resources/gitloupe.svg"
        }
      ]
    },
    "views": {
      "gitloupe": [
        {
          "id": "gitloupe.welcomeView",
          "name": "Welcome",
          "type": "webview"
        },
        {
          "id": "gitloupe.homeView",
          "name": "Home",
          "type": "webview"
        },
        {
          "id": "gitloupe.inspectView",
          "name": "Inspect",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "GitLoupe",
      "properties": {
        "gitloupe.graph.maxCommits": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Maximum number of commits loaded into the graph."
        },
        "gitloupe.git.path": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "gitloupe.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline current-line blame and the status-bar blame."
        },
        "gitloupe.blame.format": {
          "type": "string",
          "default": "${author}, ${date}",
          "description": "Inline blame format. Tokens: ${author} ${email} ${date} ${commit} ${message}."
        },
        "gitloupe.blame.heatmap": {
          "type": "boolean",
          "default": false,
          "description": "Color the overview ruler by how recently each line changed."
        },
        "gitloupe.blame.heatmapMaxLines": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 50000,
          "description": "Skip the heatmap for files with more lines than this."
        },
        "gitloupe.blame.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show authorship CodeLens at the top of files and on document symbols."
        },
        "gitloupe.blame.codeLensSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Include per-symbol authorship CodeLens using document symbols."
        },
        "gitloupe.blame.fileAnnotations": {
          "type": "boolean",
          "default": false,
          "description": "Show blame annotations at the first line of each contiguous blame block."
        },
        "gitloupe.ollama.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Local or private-network Ollama endpoint. Public Internet hosts are rejected."
        },
        "gitloupe.ollama.model": {
          "type": "string",
          "default": "",
          "description": "Ollama model used for local commit messages and explanations. Use “GitLoupe: Select Local Ollama Model”."
        },
        "gitloupe.ollama.timeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 5000,
          "maximum": 600000,
          "description": "Timeout for local Ollama requests in milliseconds."
        },
        "gitloupe.ollama.maxDiffCharacters": {
          "type": "number",
          "default": 100000,
          "minimum": 10000,
          "maximum": 1000000,
          "description": "Maximum diff characters sent to the configured Ollama endpoint."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.cjs",
    "test:extension": "npm run build && tsc -p tsconfig.extension-test.json && node scripts/run-extension-tests.cjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:extension && npm run package && npm audit --audit-level=high",
    "package": "npm run check && npm test && npm run build && vsce package --no-dependencies --readme-path README.marketplace.md"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
